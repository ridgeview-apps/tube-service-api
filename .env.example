APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./tube_service.db
TFL_API_KEY=
CLIENT_API_KEYS={"ios":["replace-with-at-least-32-random-characters"]}
POLL_INTERVAL_SECONDS=900
NOTIFICATION_DELIVERY_BATCH_SIZE=100
NOTIFICATION_DELIVERY_POLL_INTERVAL_SECONDS=30
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_IDS={"production":"ios-production-bundle-id","beta":"ios-beta-bundle-id"}
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true
APNS_TEST_PUSH_ENABLED=false
